{
  "compilerOptions": {

    "paths": {
      "@types": [ "./types/index" ],
      "@schemas": [ "./schemas/index" ]
    },
    "module": "esnext",
    "target": "esnext",

    "strict": true,

    "skipLibCheck": true,
