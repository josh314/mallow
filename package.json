    "db:seed:dev": "tsx -r dotenv/config db/seeds/dev.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:int": "jest --config jest.int.config.cjs"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "debug": "^4.4.3",
    "express": "^5.2.1",
    "postgres": "^3.4.7",
    "zod": "^4.2.1"
